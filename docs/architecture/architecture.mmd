flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Cli(["CLI<br/>optimize, report"]):::edge
        Runner["Experiment runner<br/>resumable jobs"]:::control
        Dspy(["DSPy 3.4.1<br/>RoutedLM adapter"]):::edge
        Splits["Seeded splits<br/>train, val, test"]:::control
        Service["HTTP service<br/>reference classifier"]:::core
        Cli --> Runner ~~~ Dspy ~~~ Splits ~~~ Service
    end

    subgraph Core["Optimizers (one contract)"]
        direction TB
        Contract["Optimizer context<br/>budget, memo, batches"]:::control
        Search["Instruction search<br/>APE, OPRO, Breeder"]:::core
        Feedback["Feedback driven<br/>TextGrad, GEPA Pareto"]:::core
        Demos["Demo search<br/>bootstrap, MIPROv2 TPE"]:::core
        Reference["Reference optimizers<br/>simulated model"]:::core
        Contract --> Search ~~~ Feedback ~~~ Demos ~~~ Reference
    end

    subgraph Models["Models and data"]
        direction TB
        Client["CachedLM<br/>async batched client"]:::core
        Cache[("Response cache<br/>SQLite, content hash")]:::data
        Server(["llama-server<br/>Qwen3.5 0.8B, 2B, 4B"]):::edge
        Bench[("Benchmarks<br/>GSM8K, BBH, MATH, ...")]:::data
        Client --> Cache ~~~ Server ~~~ Bench
    end

    subgraph Obs["Evaluation and outputs"]
        direction TB
        Test["Test scoring<br/>ordered prefix"]:::obs
        Meter["Cost meter<br/>calls and tokens"]:::obs
        Stats["Statistics<br/>bootstrap, paired"]:::obs
        Report["Results tables<br/>JSON per example"]:::obs
        Overfit["Overfitting check<br/>val versus test"]:::obs
        Test --> Stats --> Report ~~~ Meter ~~~ Overfit
    end

    Interfaces -->|budget| Core
    Core -->|rollouts| Models
    Models -.->|usage| Obs
