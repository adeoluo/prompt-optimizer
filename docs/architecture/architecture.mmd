flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Cli(["CLI<br/>evaluate, predict, serve"]):::edge
        Client(["HTTP client<br/>JSON text"]):::edge
        Router["HTTP router<br/>/predict, /compile"]:::core
        Validate["Validation<br/>text up to 2000 chars"]:::control
        Cli ~~~ Client --> Router --> Validate
    end

    subgraph Core["Compile and predict"]
        direction TB
        Compound["CompoundOptimizer<br/>coordinate ascent"]:::core
        Instr["InstructionSearch<br/>best candidate"]:::core
        FewShot["BootstrapFewShot<br/>greedy demo selection"]:::core
        Metric["Validation metric<br/>exact match"]:::control
        Predictor["Predictor<br/>prompt plus model"]:::core
        Lm["Simulated LM<br/>nearest demo, labels"]:::core
        Compound --> Instr --> FewShot --> Metric ~~~ Predictor --> Lm
    end

    subgraph State["Data and state"]
        direction TB
        Cands[("Candidate<br/>instructions")]:::data
        Splits[("Intent task splits<br/>train, validation, test")]:::data
        Prompt[("Compiled prompt<br/>instruction + demos")]:::data
        Cands ~~~ Splits ~~~ Prompt
    end

    subgraph Obs["Evaluation and outputs"]
        direction TB
        Prediction["Prediction JSON<br/>label"]:::obs
        Trace["OptimizationResult<br/>score, search trace"]:::obs
        Ablation["Ablation table<br/>four prompts, test"]:::obs
        Metrics["/metrics<br/>Prometheus text"]:::obs
        Prediction ~~~ Trace ~~~ Ablation ~~~ Metrics
    end

    Interfaces -->|text| Core
    Core -->|reads, writes| State
    State -.->|test split| Obs
    Core -->|labels, scores| Obs
