---
title: System Architecture - Prompt Optimizer
config:
  theme: base
  themeVariables:
    fontFamily: "Inter, system-ui, sans-serif"
    primaryColor: "#F8FAFC"
    primaryBorderColor: "#1E293B"
    primaryTextColor: "#1E293B"
    lineColor: "#64748B"
    clusterBkg: "#E2E8F0"
    clusterBorder: "#94A3B8"
---
flowchart LR
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef external fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    Train[(Training set)]:::data
    Dev[(Validation set)]:::data
    Candidates[(Candidate instructions)]:::data

    subgraph Compile["Optimization (coordinate ascent)"]
        Instruction[Instruction search]:::core
        FewShot[Bootstrap few-shot selection]:::core
    end

    Prompt[["Compiled prompt
    (instruction + demonstrations)"]]:::core
    Predictor[Predictor]:::core
    Model{{Simulated language model}}:::external
    Metric[Metric]:::core

    Candidates --> Instruction
    Train --> FewShot
    Instruction <-->|coordinate ascent| FewShot
    Dev -->|score candidates| Instruction
    Dev -->|score candidates| FewShot
    Instruction --> Prompt
    FewShot --> Prompt
    Prompt --> Predictor
    Predictor -->|generate| Model
    Model -->|label| Metric
    Metric -.->|validation score| Instruction
    Metric -.->|validation score| FewShot
